#!/usr/bin/env bash
set -euo pipefail

# Only log to /dev/tty if DEBUG=1 is set
log() {
  if [[ "${DEBUG:-0}" == "1" && -c /dev/tty ]]; then
    echo "[git-credential-bw] $*" >/dev/tty
  fi
}

action="${1:-}"
log "Triggered with action: '$action'"

if [[ "$action" != "get" && "$action" != "store" && "$action" != "erase" ]]; then
  log "Action '$action' ignored. Exiting."
  exit 0
fi

# 1. Read Git's input from standard input FIRST
protocol=""
host=""
username=""
password=""

while IFS='=' read -r key value; do
  [[ -z "$key" ]] && break
  case "$key" in
    protocol) protocol="$value" ;;
    host)     host="$value" ;;
    username) username="$value" ;;
    password) password="$value" ;;
  esac
done

masked_pass="<not set>"
[[ -n "$password" ]] && masked_pass="<set: length ${#password}>"
log "Input received: protocol='$protocol', host='$host', username='$username', password=$masked_pass"

if [[ -z "$host" ]]; then
  log "FATAL: Host was not provided by Git."
  exit 0
fi

# Host-specific marker file (independent of sub-process PIDs)
host_slug=$(echo "$host" | tr -cd '[:alnum:]._-')
save_marker="/tmp/.git-credential-bw-save-${host_slug}"

# Helper function to check if a marker is still fresh (< 5 minutes old)
marker_is_fresh() {
  local file="$1"
  if [[ -f "$file" ]]; then
    local file_age
    file_age=$(($(date +%s) - $(date -r "$file" +%s 2>/dev/null || stat -c %Y "$file" 2>/dev/null || echo 0)))
    [[ $file_age -lt 300 ]]
  else
    false
  fi
}

# --- HANDLE 'ERASE' ---
if [[ "$action" == "erase" ]]; then
  log "Erase called (auth failure). Flagging that next store for $host must update Bitwarden."
  touch "$save_marker"
  exit 0
fi

# --- FAST PATH: SKIP STORE ON CACHE HITS ---
if [[ "$action" == "store" ]]; then
  if ! marker_is_fresh "$save_marker"; then
    log "Cache hit or existing Bitwarden credential (no save flagged for $host). Skipping store."
    rm -f "$save_marker"
    exit 0
  fi

  # Marker is fresh: consume it and proceed to Bitwarden write
  rm -f "$save_marker"
  log "Save flag detected for $host. Proceeding to save/update Bitwarden."
fi

# 2. Dependency checks
if ! command -v bw &>/dev/null || ! command -v jq &>/dev/null; then
  log "FATAL: Missing required command 'bw' or 'jq' in PATH."
  exit 0
fi

# 3. Source the secrets profile to load the bw_login function
SECRETS_FILE="$HOME/.shell_profile/configs/secrets.sh"
if [[ -f "$SECRETS_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$SECRETS_FILE"
else
  log "FATAL: Secrets file not found at $SECRETS_FILE"
  exit 0
fi

# 4. Authenticate / Ensure active session via bw_login
log "Invoking bw_login..."
if [[ -c /dev/tty ]]; then
  bw_login </dev/tty >/dev/tty 2>&1 || true
else
  log "No /dev/tty available; attempting bw_login without controlling terminal..."
  bw_login </dev/null >/dev/null 2>&1 || true
fi

if [[ -z "${BW_SESSION:-}" ]]; then
  log "FATAL: bw_login finished or failed, and BW_SESSION remains unset."
  exit 0
fi

export BW_SESSION
log "Bitwarden session confirmed active."

item_title="Git Credential: $host"
target_uri="${protocol:+$protocol://}${host}"

# --- HANDLE 'GET' ---
if [[ "$action" == "get" ]]; then
  log "Searching for item: '$item_title'"
  items_json=$(bw list items --search "$item_title" 2>/dev/null || true)

  match=""
  if [[ -n "$items_json" && "$items_json" != "[]" ]]; then
    if [[ -n "$username" ]]; then
      match=$(echo "$items_json" | jq -r --arg title "$item_title" --arg u "$username" \
        '[.[] | select(.type == 1 and .name == $title and .login.username == $u)] | first // empty' 2>/dev/null)
    else
      match=$(echo "$items_json" | jq -r --arg title "$item_title" \
        '[.[] | select(.type == 1 and .name == $title)] | first // empty' 2>/dev/null)
    fi
  fi

  retrieved_user=""
  retrieved_pass=""
  if [[ -n "$match" && "$match" != "null" ]]; then
    retrieved_user=$(echo "$match" | jq -r '.login.username // empty' 2>/dev/null)
    retrieved_pass=$(echo "$match" | jq -r '.login.password // empty' 2>/dev/null)
  fi

  # If not found in Bitwarden, flag the host so the subsequent store writes it
  if [[ -z "$retrieved_pass" ]]; then
    log "Item not found in Bitwarden. Flagging $host for store."
    touch "$save_marker"
    exit 0
  fi

  # Found in Bitwarden: clear any marker and output credentials
  rm -f "$save_marker"
  [[ -n "$retrieved_user" ]] && echo "username=$retrieved_user"
  echo "password=$retrieved_pass"
  log "Successfully emitted credentials from '$item_title' to Git."
  exit 0
fi

# --- HANDLE 'STORE' (TRIGGERED ONLY ON NEW OR ROTATED CREDENTIALS) ---
if [[ "$action" == "store" ]]; then
  if [[ -z "$password" ]]; then
    log "No password provided by Git to store. Exiting."
    exit 0
  fi

  items_json=$(bw list items --search "$item_title" 2>/dev/null || true)
  existing_item=""

  if [[ -n "$items_json" && "$items_json" != "[]" ]]; then
    if [[ -n "$username" ]]; then
      existing_item=$(echo "$items_json" | jq -r --arg title "$item_title" --arg u "$username" \
        '[.[] | select(.type == 1 and .name == $title and .login.username == $u)] | first // empty' 2>/dev/null)
    else
      existing_item=$(echo "$items_json" | jq -r --arg title "$item_title" \
        '[.[] | select(.type == 1 and .name == $title)] | first // empty' 2>/dev/null)
    fi
  fi

  if [[ -n "$existing_item" && "$existing_item" != "null" ]]; then
    existing_id=$(echo "$existing_item" | jq -r '.id')
    log "Updating existing item '$item_title' (ID: $existing_id)"
    updated_payload=$(echo "$existing_item" | jq \
      --arg u "${username:-}" \
      --arg p "$password" \
      '.login.password = $p | if $u != "" then .login.username = $u else . end' 2>/dev/null)

    echo "$updated_payload" | bw encode | bw edit item "$existing_id" >/dev/null 2>&1
    log "Existing item updated."
  else
    log "Creating new item '$item_title' ($target_uri)"
    new_item=$(jq -n \
      --arg name "$item_title" \
      --arg uri "$target_uri" \
      --arg u "${username:-}" \
      --arg p "$password" \
      '{
        type: 1,
        name: $name,
        notes: "Created automatically by git-credential-bw",
        login: {
          uris: [{ match: null, uri: $uri }],
          username: $u,
          password: $p
        }
      }' 2>/dev/null)

    echo "$new_item" | bw encode | bw create item >/dev/null 2>&1
    log "New item created."
  fi

  log "Store operation completed successfully."
  exit 0
fi
