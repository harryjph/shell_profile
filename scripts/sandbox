#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage: sandbox <app> [args...]" >&2
  exit 1
fi

# Ensure default configs are loaded if not already in environment
if [[ -f "$HOME/.shell_profile/configs/sandbox.sh" ]]; then
  source "$HOME/.shell_profile/configs/sandbox.sh"
fi

IMAGE="${SANDBOX_IMAGE:-fedora}"
APP_CMD="$1"
APP_NAME="$(basename "$APP_CMD")"
# Sanitize app name for variable lookup
APP_VAR_SUFFIX="${APP_NAME//[^a-zA-Z0-9_]/_}"
APP_VAR_UPPER="${APP_VAR_SUFFIX^^}"

# Collect RO and RW path definitions
RO_PATHS="${SANDBOX_PATH:-/bin:/usr:${HOME}/.local/bin:${PATH}}"
if [[ -n "${LD_LIBRARY_PATH:-}" ]]; then
  RO_PATHS="${RO_PATHS:+${RO_PATHS}:}${LD_LIBRARY_PATH}"
fi
RW_PATHS="${SANDBOX_PATH_RW:-}"

# Check for app-specific RO overrides (exact and uppercase)
app_ro_var="SANDBOX_PATH_${APP_VAR_SUFFIX}"
if [[ -n "${!app_ro_var:-}" ]]; then
  RO_PATHS="${RO_PATHS:+${RO_PATHS}:}${!app_ro_var}"
fi
app_ro_upper_var="SANDBOX_PATH_${APP_VAR_UPPER}"
if [[ "$APP_VAR_UPPER" != "$APP_VAR_SUFFIX" ]] && [[ -n "${!app_ro_upper_var:-}" ]]; then
  RO_PATHS="${RO_PATHS:+${RO_PATHS}:}${!app_ro_upper_var}"
fi

# Check for app-specific RW overrides (exact and uppercase)
app_rw_var="SANDBOX_PATH_RW_${APP_VAR_SUFFIX}"
if [[ -n "${!app_rw_var:-}" ]]; then
  RW_PATHS="${RW_PATHS:+${RW_PATHS}:}${!app_rw_var}"
fi
app_rw_upper_var="SANDBOX_PATH_RW_${APP_VAR_UPPER}"
if [[ "$APP_VAR_UPPER" != "$APP_VAR_SUFFIX" ]] && [[ -n "${!app_rw_upper_var:-}" ]]; then
  RW_PATHS="${RW_PATHS:+${RW_PATHS}:}${!app_rw_upper_var}"
fi

# Collect Environment Variables to pass through
ENV_LIST="${SANDBOX_ENV:-HOME:PATH:LD_LIBRARY_PATH}"
app_env_var="SANDBOX_ENV_${APP_VAR_SUFFIX}"
if [[ -n "${!app_env_var:-}" ]]; then
  ENV_LIST="${ENV_LIST:+${ENV_LIST}:}${!app_env_var}"
fi
app_env_upper_var="SANDBOX_ENV_${APP_VAR_UPPER}"
if [[ "$APP_VAR_UPPER" != "$APP_VAR_SUFFIX" ]] && [[ -n "${!app_env_upper_var:-}" ]]; then
  ENV_LIST="${ENV_LIST:+${ENV_LIST}:}${!app_env_upper_var}"
fi

# Working directory is always RW
CWD="$(pwd)"
RW_PATHS="${RW_PATHS:+${RW_PATHS}:}${CWD}"

# Build podman volume mount flags
declare -A SEEN_MOUNTS=()
MOUNT_ARGS=()

add_mounts() {
  local path_list="$1"
  local mode="$2"
  local IFS=':'
  local raw_paths=()
  read -ra raw_paths <<< "$path_list"

  for raw_path in "${raw_paths[@]}"; do
    [[ -z "$raw_path" ]] && continue
    # Expand ~ to $HOME
    local expanded_path="${raw_path/#\~/$HOME}"

    if [[ ! -e "$expanded_path" ]]; then
      continue
    fi

    # Normalize trailing slash
    [[ "$expanded_path" != "/" ]] && expanded_path="${expanded_path%/}"

    # Avoid duplicate mounts
    if [[ -n "${SEEN_MOUNTS[$expanded_path]:-}" ]]; then
      continue
    fi

    # Avoid mounting subpaths if already covered by an existing parent mount
    local seen
    local already_covered=0
    for seen in "${!SEEN_MOUNTS[@]}"; do
      if [[ "$expanded_path" == "$seen"/* ]]; then
        already_covered=1
        break
      fi
    done
    if [[ $already_covered -eq 1 ]]; then
      continue
    fi
    SEEN_MOUNTS["$expanded_path"]=1

    MOUNT_ARGS+=("-v" "${expanded_path}:${expanded_path}:${mode}")
  done
}

# Add RW mounts first so specific paths are writable, then RO mounts
add_mounts "$RW_PATHS" "rw"
add_mounts "$RO_PATHS" "ro"

# Build environment flags
declare -A SEEN_ENVS=()
ENV_ARGS=()

add_envs() {
  local env_list="$1"
  local IFS=':'
  local raw_envs=()
  read -ra raw_envs <<< "$env_list"

  for item in "${raw_envs[@]}"; do
    [[ -z "$item" ]] && continue
    local var_name="${item%%=*}"
    if [[ -n "${SEEN_ENVS[$var_name]:-}" ]]; then
      continue
    fi
    SEEN_ENVS["$var_name"]=1

    ENV_ARGS+=("-e" "$item")
  done
}

add_envs "$ENV_LIST"

PODMAN_FLAGS=(
  "--rm"
  "-i"
  "--userns=keep-id"
  "--security-opt" "label=disable"
  "--cap-drop=ALL"
  "--security-opt=no-new-privileges"
  "--pids-limit=2048"
  "--workdir" "$CWD"
  "-e" "TERM=${TERM:-xterm-256color}"
  "-e" "COLORTERM=${COLORTERM:-}"
  "-e" "LANG=${LANG:-en_US.UTF-8}"
)

if [[ -t 0 ]] && [[ -t 1 ]]; then
  PODMAN_FLAGS+=("-t")
fi

if [[ -n "${SANDBOX_DRY_RUN:-}" ]]; then
  echo "podman run ${PODMAN_FLAGS[*]} ${ENV_ARGS[*]} ${MOUNT_ARGS[*]} $IMAGE $*"
  exit 0
fi

exec podman run "${PODMAN_FLAGS[@]}" "${ENV_ARGS[@]}" "${MOUNT_ARGS[@]}" "$IMAGE" "$@"
