#!/usr/bin/env bash
set -euo pipefail

if [ -z "${BW_SESSION:-}" ]; then
  echo "Error: BW_SESSION is not set. Run 'export BW_SESSION=\$(bw unlock --raw)' first." >&2
  exit 1
fi

if [ $# -lt 1 ]; then
  echo "Usage: $0 <path-to-file>" >&2
  echo "Example: $0 ~/.git-credentials" >&2
  exit 1
fi

LOCAL_FILE="$1"

# Expand path to check existence
if [[ "$LOCAL_FILE" == ~* ]]; then
  EXPANDED_LOCAL="${LOCAL_FILE/#\~/$HOME}"
else
  EXPANDED_LOCAL="$(cd "$(dirname "$LOCAL_FILE")" 2>/dev/null && pwd)/$(basename "$LOCAL_FILE")" || EXPANDED_LOCAL="$LOCAL_FILE"
fi

if [ ! -f "$EXPANDED_LOCAL" ]; then
  echo "Error: Local file '$EXPANDED_LOCAL' not found." >&2
  exit 1
fi

FILE_NAME="$(basename "$EXPANDED_LOCAL")"

# Build vault-friendly name matching bw_put conventions
if [[ "$EXPANDED_LOCAL" == "$HOME"* ]]; then
  VAULT_NAME="dotfile: ~${EXPANDED_LOCAL#"$HOME"}"
else
  VAULT_NAME="dotfile: $EXPANDED_LOCAL"
fi

# Locate container item in Bitwarden
ITEM_JSON="$(bw list items --search "$VAULT_NAME" | jq -c --arg name "$VAULT_NAME" '.[] | select(.name == $name)' | head -n 1)"

if [ -z "$ITEM_JSON" ]; then
  echo "Error: Vault item '$VAULT_NAME' not found." >&2
  exit 1
fi

ITEM_ID="$(echo "$ITEM_JSON" | jq -r '.id')"

# Locate matching attachment filename
ATTACHMENT_NAME="$(echo "$ITEM_JSON" | jq -r --arg fn "$FILE_NAME" \
  '([.attachments[]? | select(.fileName == $fn) | .fileName] + [.attachments[]?.fileName])[0] // empty')"

if [ -z "$ATTACHMENT_NAME" ]; then
  echo "Error: No attachments found in vault item '$VAULT_NAME'." >&2
  exit 1
fi

# Set up secure temporary file for the remote copy
TMP_REMOTE="$(mktemp "/tmp/bw_diff_${FILE_NAME}.XXXXXX")"
trap 'rm -f "$TMP_REMOTE"' EXIT

# Fetch the remote attachment
bw get attachment "$ATTACHMENT_NAME" --itemid "$ITEM_ID" --output "$TMP_REMOTE" >/dev/null

# Diff vault (left) vs local (right) and pipe to bat
diff -u \
  --label "$VAULT_NAME (vault)" \
  --label "$LOCAL_FILE (local)" \
  "$TMP_REMOTE" "$EXPANDED_LOCAL" | bat -l diff || true
