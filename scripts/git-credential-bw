#!/usr/bin/env bash
set -euo pipefail

action="${1:-}"

# 'erase' can exit cleanly; only handle 'get' and 'store'
if [[ "$action" != "get" && "$action" != "store" ]]; then
  exit 0
fi

# Ensure dependencies exist
if ! command -v bw &>/dev/null || ! command -v jq &>/dev/null; then
  exit 0
fi

# Vault must be unlocked
if [[ -z "${BW_SESSION:-}" ]]; then
  exit 0
fi

# Read Git's key=value input from stdin
protocol=""
host=""
username=""
password=""

while IFS='=' read -r key value; do
  [[ -z "$key" ]] && break
  case "$key" in
    protocol) protocol="$value" ;;
    host)     host="$value" ;;
    username) username="$value" ;;
    password) password="$value" ;;
  esac
done

if [[ -z "$host" ]]; then
  exit 0
fi

# Target URI for matching/saving
target_uri="${protocol:+$protocol://}${host}"

# --- HANDLE 'GET' ---
if [[ "$action" == "get" ]]; then
  items_json=$(bw list items --url "$host" 2>/dev/null || true)
  if [[ -z "$items_json" || "$items_json" == "[]" ]]; then
    exit 0
  fi

  if [[ -n "$username" ]]; then
    match=$(echo "$items_json" | jq -r --arg u "$username" \
      '[.[] | select(.type == 1 and .login.username == $u)] | first // empty')
  else
    match=$(echo "$items_json" | jq -r '[.[] | select(.type == 1)] | first // empty')
  fi

  if [[ -z "$match" || "$match" == "null" ]]; then
    exit 0
  fi

  retrieved_user=$(echo "$match" | jq -r '.login.username // empty')
  retrieved_pass=$(echo "$match" | jq -r '.login.password // empty')

  if [[ -n "$retrieved_pass" ]]; then
    [[ -n "$retrieved_user" ]] && echo "username=$retrieved_user"
    echo "password=$retrieved_pass"
  fi
  exit 0
fi

# --- HANDLE 'STORE' ---
if [[ "$action" == "store" ]]; then
  if [[ -z "$password" ]]; then
    exit 0
  fi

  items_json=$(bw list items --url "$host" 2>/dev/null || true)
  existing_id=""

  if [[ -n "$items_json" && "$items_json" != "[]" ]]; then
    if [[ -n "$username" ]]; then
      existing_id=$(echo "$items_json" | jq -r --arg u "$username" \
        '[.[] | select(.type == 1 and .login.username == $u)] | first | .id // empty')
    else
      existing_id=$(echo "$items_json" | jq -r \
        '[.[] | select(.type == 1)] | first | .id // empty')
    fi
  fi

  if [[ -n "$existing_id" && "$existing_id" != "null" ]]; then
    # Update existing entry
    item_json=$(bw get item "$existing_id" 2>/dev/null || true)
    if [[ -n "$item_json" ]]; then
      updated_payload=$(echo "$item_json" | jq \
        --arg u "${username:-}" \
        --arg p "$password" \
        '.login.password = $p | if $u != "" then .login.username = $u else . end')

      echo "$updated_payload" | bw encode | bw edit item "$existing_id" >/dev/null 2>&1
    fi
  else
    # Create a new login entry from template
    template=$(bw get template item.login 2>/dev/null || true)
    if [[ -n "$template" ]]; then
      new_item=$(bw get template item 2>/dev/null | jq \
        --arg name "Git: $host" \
        --arg uri "$target_uri" \
        --arg u "${username:-}" \
        --arg p "$password" \
        '.type = 1
         | .name = $name
         | .login = {
             "uris": [{"match": null, "uri": $uri}],
             "username": $u,
             "password": $p
           }')

      echo "$new_item" | bw encode | bw create item >/dev/null 2>&1
    fi
  fi

  exit 0
fi
