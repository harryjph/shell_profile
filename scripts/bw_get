#!/usr/bin/env bash
set -euo pipefail

if [ -z "${BW_SESSION:-}" ]; then
  echo "Error: BW_SESSION is not set. Run 'export BW_SESSION=\$(bw unlock --raw)' first." >&2
  exit 1
fi

if [ $# -lt 1 ]; then
  echo "Usage: $0 <vault-file-name-or-path> [output-path]" >&2
  echo "Example: $0 ~/.git-credentials" >&2
  exit 1
fi

TARGET="$1"
OUTPUT_PATH="${2:-}"

# Normalize target name
if [[ "$TARGET" != dotfile:* ]]; then
  if [[ "$TARGET" == "$HOME"* ]]; then
    VAULT_NAME="dotfile: ~${TARGET#"$HOME"}"
  elif [[ "$TARGET" == ~* ]]; then
    VAULT_NAME="dotfile: $TARGET"
  else
    ABS_TARGET="$(cd "$(dirname "$TARGET")" 2>/dev/null && pwd)/$(basename "$TARGET")" || ABS_TARGET="$TARGET"
    if [[ "$ABS_TARGET" == "$HOME"* ]]; then
      VAULT_NAME="dotfile: ~${ABS_TARGET#"$HOME"}"
    else
      VAULT_NAME="dotfile: $ABS_TARGET"
    fi
  fi
else
  VAULT_NAME="$TARGET"
fi

# Determine write path
if [ -z "$OUTPUT_PATH" ]; then
  RESTORE_PATH="${VAULT_NAME#dotfile: }"
  OUTPUT_PATH="${RESTORE_PATH/#\~/$HOME}"
fi

TARGET_FILE_NAME="$(basename "$OUTPUT_PATH")"

# Retrieve item
ITEM_JSON="$(bw list items --search "$VAULT_NAME" | jq -c --arg name "$VAULT_NAME" '.[] | select(.name == $name)' | head -n 1)"

if [ -z "$ITEM_JSON" ]; then
  echo "Error: Vault item '$VAULT_NAME' not found." >&2
  exit 1
fi

ITEM_ID="$(echo "$ITEM_JSON" | jq -r '.id')"

# Match attachment name, or fall back to the first available attachment
ATTACHMENT_NAME="$(echo "$ITEM_JSON" | jq -r --arg fn "$TARGET_FILE_NAME" \
  '([.attachments[]? | select(.fileName == $fn) | .fileName] + [.attachments[]?.fileName])[0] // empty')"

if [ -z "$ATTACHMENT_NAME" ]; then
  echo "Error: No attachments found in '$VAULT_NAME'." >&2
  exit 1
fi

# Ensure output directory exists
mkdir -p "$(dirname "$OUTPUT_PATH")"

# Download attachment directly to destination
bw get attachment "$ATTACHMENT_NAME" --itemid "$ITEM_ID" --output "$OUTPUT_PATH" >/dev/null

chmod 600 "$OUTPUT_PATH"
echo "Downloaded '$ATTACHMENT_NAME' to $OUTPUT_PATH (permissions: 600)"
