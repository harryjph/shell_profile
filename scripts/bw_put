#!/usr/bin/env bash
set -euo pipefail

FOLDER_NAME="Dotfiles"

if [ -z "${BW_SESSION:-}" ]; then
  echo "❌ Error: BW_SESSION is not set. Run 'export BW_SESSION=\$(bw unlock --raw)' first." >&2
  exit 1
fi

if [ $# -lt 1 ]; then
  echo "ℹ️  Usage: $0 <path-to-file>" >&2
  exit 1
fi

FILE_PATH="$1"

if [ ! -f "$FILE_PATH" ]; then
  echo "❌ Error: File '$FILE_PATH' not found." >&2
  exit 1
fi

FILE_NAME="$(basename "$FILE_PATH")"
ABS_PATH="$(cd "$(dirname "$FILE_PATH")" && pwd)/$FILE_NAME"

# Build vault-friendly name (e.g., dotfile: ~/.git-credentials)
if [[ "$ABS_PATH" == "$HOME"* ]]; then
  VAULT_NAME="dotfile: ~${ABS_PATH#"$HOME"}"
else
  VAULT_NAME="dotfile: $ABS_PATH"
fi

# Ensure the target folder exists and get its ID
FOLDER_ID="$(bw list folders | jq -r --arg name "$FOLDER_NAME" '.[] | select(.name == $name) | .id' | head -n 1)"
if [ -z "$FOLDER_ID" ]; then
  echo "📁 Creating folder '$FOLDER_NAME' in vault..."
  FOLDER_TEMPLATE="$(bw get template folder)"
  FOLDER_JSON="$(echo "$FOLDER_TEMPLATE" | jq --arg name "$FOLDER_NAME" '.name = $name' | bw encode | bw create folder)"
  FOLDER_ID="$(echo "$FOLDER_JSON" | jq -r '.id')"
fi

# Find container Secure Note inside the target folder
ITEM_JSON="$(bw list items --folderid "$FOLDER_ID" --search "$VAULT_NAME" | jq -c --arg name "$VAULT_NAME" '.[] | select(.name == $name)' | head -n 1)"

if [ -z "$ITEM_JSON" ]; then
  echo "📝 Creating new container note in '$FOLDER_NAME': $VAULT_NAME..."
  TEMPLATE="$(bw get template item)"
  ITEM_JSON="$(echo "$TEMPLATE" | jq \
    --arg name "$VAULT_NAME" \
    --arg notes "Dotfile synced via bw_put." \
    --arg folderId "$FOLDER_ID" \
    '.name = $name | .folderId = $folderId | .type = 2 | .secureNote = {"type": 0} | .notes = $notes' | bw encode | bw create item)"
  ITEM_ID="$(echo "$ITEM_JSON" | jq -r '.id')"
else
  ITEM_ID="$(echo "$ITEM_JSON" | jq -r '.id')"

  # Locate existing active attachment matching FILE_NAME
  CURRENT_ATT_ID="$(echo "$ITEM_JSON" | jq -r --arg fn "$FILE_NAME" '.attachments[]? | select(.fileName == $fn) | .id' | head -n 1)"

  if [ -n "$CURRENT_ATT_ID" ]; then
    TMP_DIR="$(mktemp -d "/tmp/bw_put_check.XXXXXX")"
    trap 'rm -rf "$TMP_DIR"' EXIT

    EXISTING_FILE="${TMP_DIR}/${FILE_NAME}"
    bw get attachment "$FILE_NAME" --itemid "$ITEM_ID" --output "$EXISTING_FILE" >/dev/null

    # Compare local file with vault copy; exit early if identical
    if cmp -s "$FILE_PATH" "$EXISTING_FILE"; then
      echo "ℹ️  No changes detected for '$VAULT_NAME'. Skipping."
      exit 0
    fi

    # Changes exist: archive the old version
    TIMESTAMP="$(date -u +"%Y%m%dT%H%M%SZ")"
    ARCHIVE_NAME="${FILE_NAME}.${TIMESTAMP}.bak"
    ARCHIVE_PATH="${TMP_DIR}/${ARCHIVE_NAME}"

    mv "$EXISTING_FILE" "$ARCHIVE_PATH"

    echo "📦 Archiving previous version as '$ARCHIVE_NAME'..."
    bw create attachment --file "$ARCHIVE_PATH" --itemid "$ITEM_ID" >/dev/null

    # Remove the unversioned copy to free the slot
    bw delete attachment "$CURRENT_ATT_ID" --itemid "$ITEM_ID" >/dev/null
  fi
fi

# Upload current local file as active attachment
echo "⬆️  Uploading new '$FILE_NAME' as active attachment..."
bw create attachment --file "$FILE_PATH" --itemid "$ITEM_ID" >/dev/null

echo "✅ Successfully updated '$VAULT_NAME' in '$FOLDER_NAME' with full version history."
