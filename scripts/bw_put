#!/usr/bin/env bash
set -euo pipefail

if [ -z "${BW_SESSION:-}" ]; then
  echo "Error: BW_SESSION is not set. Run 'export BW_SESSION=\$(bw unlock --raw)' first." >&2
  exit 1
fi

if [ $# -lt 1 ]; then
  echo "Usage: $0 <path-to-file>" >&2
  exit 1
fi

FILE_PATH="$1"

if [ ! -f "$FILE_PATH" ]; then
  echo "Error: File '$FILE_PATH' not found." >&2
  exit 1
fi

FILE_NAME="$(basename "$FILE_PATH")"
ABS_PATH="$(cd "$(dirname "$FILE_PATH")" && pwd)/$FILE_NAME"

# Build vault-friendly name (e.g., dotfile: ~/.git-credentials)
if [[ "$ABS_PATH" == "$HOME"* ]]; then
  VAULT_NAME="dotfile: ~${ABS_PATH#"$HOME"}"
else
  VAULT_NAME="dotfile: $ABS_PATH"
fi

# Find or create vault item
ITEM_JSON="$(bw list items --search "$VAULT_NAME" | jq -c --arg name "$VAULT_NAME" '.[] | select(.name == $name)' | head -n 1)"

if [ -z "$ITEM_JSON" ]; then
  echo "Creating new container note: $VAULT_NAME..."
  TEMPLATE="$(bw get template item)"
  ITEM_JSON="$(echo "$TEMPLATE" | jq \
    --arg name "$VAULT_NAME" \
    --arg notes "Dotfile synced via bw_put. Original path: $ABS_PATH" \
    '.name = $name | .type = 2 | .secureNote = {"type": 0} | .notes = $notes' | bw encode | bw create item)"
  ITEM_ID="$(echo "$ITEM_JSON" | jq -r '.id')"
else
  ITEM_ID="$(echo "$ITEM_JSON" | jq -r '.id')"
  echo "Found existing container: $VAULT_NAME ($ITEM_ID)"

  # Remove existing attachment with the same name if present
  ATTACHMENT_ID="$(echo "$ITEM_JSON" | jq -r --arg fn "$FILE_NAME" '.attachments[]? | select(.fileName == $fn) | .id' | head -n 1)"
  if [ -n "$ATTACHMENT_ID" ]; then
    echo "Replacing existing attachment '$FILE_NAME'..."
    bw delete attachment "$ATTACHMENT_ID" --itemid "$ITEM_ID" >/dev/null
  fi
fi

# Upload attachment
echo "Uploading '$FILE_NAME' as attachment..."
bw create attachment --file "$FILE_PATH" --itemid "$ITEM_ID" >/dev/null

echo "Successfully saved '$VAULT_NAME' ($FILE_NAME) to Bitwarden."
