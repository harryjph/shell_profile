#!/usr/bin/env bash
set -euo pipefail

if [ -z "${BW_SESSION:-}" ]; then
  echo "Error: BW_SESSION is not set. Run 'export BW_SESSION=\$(bw unlock --raw)' first." >&2
  exit 1
fi

if [ $# -lt 1 ]; then
  echo "Usage: $0 <path-to-file>" >&2
  exit 1
fi

FILE_PATH="$1"

if [ ! -f "$FILE_PATH" ]; then
  echo "Error: File '$FILE_PATH' not found." >&2
  exit 1
fi

# Resolve absolute path
ABS_PATH="$(cd "$(dirname "$FILE_PATH")" && pwd)/$(basename "$FILE_PATH")"

# Build vault-friendly name (e.g., ~/.git-credentials or ~/config/.env)
if [[ "$ABS_PATH" == "$HOME"* ]]; then
  VAULT_NAME="dotfile: ~${ABS_PATH#"$HOME"}"
else
  VAULT_NAME="dotfile: $ABS_PATH"
fi

# Read and encode file content safely
CONTENT="$(cat "$FILE_PATH")"

# Check if item already exists
ITEM_ID="$(bw list items --search "$VAULT_NAME" | jq -r --arg name "$VAULT_NAME" '.[] | select(.name == $name) | .id' | head -n 1)"

if [ -n "$ITEM_ID" ]; then
  echo "Updating existing vault item: $VAULT_NAME ($ITEM_ID)..."
  UPDATED_JSON="$(bw get item "$ITEM_ID" | jq --arg notes "$CONTENT" '.notes = $notes')"
  echo "$UPDATED_JSON" | bw encode | bw edit item "$ITEM_ID" >/dev/null
  echo "Successfully updated $VAULT_NAME in Bitwarden."
else
  echo "Creating new vault item: $VAULT_NAME..."
  TEMPLATE="$(bw get template item)"
  ITEM_JSON="$(echo "$TEMPLATE" | jq \
    --arg name "$VAULT_NAME" \
    --arg notes "$CONTENT" \
    '.name = $name | .type = 2 | .secureNote = {"type": 0} | .notes = $notes')"
  echo "$ITEM_JSON" | bw encode | bw create item >/dev/null
  echo "Successfully created $VAULT_NAME in Bitwarden."
fi
